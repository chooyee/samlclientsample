# --- App ---
PORT=4000
# Default base URL (the address the browser uses); editable in the SAML and OIDC settings.
BASE_URL=http://localhost:4000
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# --- Settings editable on the home page ---
# The values below (SP_ENTITY_ID through IDP_CERT, except the key files) are only defaults:
# changes saved on the home page go to SETTINGS_FILE and win until "Reset to .env values".
# Take every one of them from the CloakTail application page (Applications -> your app):
# this app knows only what a developer is given there.
SETTINGS_FILE=data/settings.json
# Local profiles created on each user's first SAML sign-in (JIT provisioning).
USERS_FILE=data/users.json

# --- Your app (SP) settings ---
# Entity ID registered in CloakTail (the Keycloak client ID). Default: BASE_URL/saml/metadata
SP_ENTITY_ID=
# "Name ID format" URN, e.g. urn:oasis:names:tc:SAML:1.1:nameid-format:unspecified for Username.
# Empty = accept whatever Keycloak sends.
NAME_ID_FORMAT=
# "Attributes", comma-separated, e.g. email, firstName, lastName. Missing ones are flagged after sign-in.
EXPECTED_ATTRIBUTES=

# "Signed": response and/or assertion.
WANT_RESPONSE_SIGNED=true
WANT_ASSERTIONS_SIGNED=true
# "Signed requests: Required": set true and upload certs/signing-cert.pem to CloakTail.
SIGN_REQUESTS=false
# "Encryption: Assertions encrypted": set true and upload certs/encryption-cert.pem to CloakTail.
DECRYPT_ASSERTIONS=false

# Key pairs created by "npm run gen:certs" or the home page (SP certificates section).
# Turning on SIGN_REQUESTS / DECRYPT_ASSERTIONS generates a missing pair automatically.
SIGNING_KEY_FILE=certs/signing-key.pem
SIGNING_CERT_FILE=certs/signing-cert.pem
ENCRYPTION_KEY_FILE=certs/encryption-key.pem
ENCRYPTION_CERT_FILE=certs/encryption-cert.pem

# --- Keycloak (IdP) details ---
IDP_METADATA_URL=
IDP_ENTITY_ID=
IDP_SSO_URL=
# Empty = "Sign out" ends only the local session.
IDP_SLO_URL=
# Optional: "IdP-initiated login" link.
IDP_INITIATED_URL=
# Optional: "Signing certificate (bare base64)". Empty = read from IDP_METADATA_URL.
IDP_CERT=

# --- OpenID Connect ---
# From an OpenID Connect application page. Register BASE_URL/oidc/callback as a redirect URI
# and BASE_URL/oidc/logged-out as a post-logout redirect URI.
# "Issuer" (the discovery document URL also works).
OIDC_ISSUER=
# "Client credentials": client ID, and the secret for a confidential client (empty = public client).
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
# Send PKCE (S256). Required when the portal's "Require PKCE" is on, and for public clients.
OIDC_USE_PKCE=true
# Comma-separated claims flagged after sign-in when missing from the ID token and userinfo. Optional.
OIDC_EXPECTED_CLAIMS=

# --- User migration through CloakTail (Migration page, /migrate) ---
# From Applications -> your app -> User migration. Verifies results (and signs requests with
# the "secret" method). Never commit it.
# The CloakTail API credential (CLOAKTAIL_CLIENT_ID / CLOAKTAIL_CLIENT_SECRET) is for setup only:
# keep it in a git-ignored .env.cloaktail or your shell profile, never here. The app doesn't use it.
CLOAKTAIL_MIGRATION_SECRET=
CLOAKTAIL_URL=http://localhost:3000
# Request signing: jwks (RS256 with this app's key, published at BASE_URL/migrate/jwks.json) or secret (HS256).
MIGRATION_REQUEST_SIGNING=jwks
# Keycloak sign-in for migrated users, and the client ID sent as iss: oidc, saml, or empty for
# OpenID Connect when it is set up, else SAML.
MIGRATION_PROTOCOL=
# Register exactly this on the migration page. Default: BASE_URL/migrate/return
MIGRATION_RETURN_URL=
# RSA private key for request signing; generated on first start.
MIGRATION_KEY_FILE=certs/migration-key.pem
# The app's own (legacy) users with passwords and the migration flag. Seeded with demo users.
LEGACY_USERS_FILE=data/legacy-users.json
# Accept results from POST /migrate/simulate. Default: true unless NODE_ENV=production.
MIGRATION_ACCEPT_SIMULATED=

# --- Registration assistant (SAML and OIDC pages) ---
# Google Gemini API key and model (e.g. gemini-flash-latest). The assistant is off unless both are set.
GEMINI_API_KEY=
GEMINI_MODEL=
# Only pre-fills the assistant's "CloakTail reference URL" field (an API guide or OpenAPI spec).
# The CloakTail API credential is entered in the form, never here.
CLOAKTAIL_REFERENCE_URL=

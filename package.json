{
  "name": "samlclientsample",
  "version": "1.0.0",
  "description": "Sample SAML service provider for testing the Keycloak developer portal end to end",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-reporter=spec test/migration.test.js test/workflow.test.js test/files.test.js",
    "gen:certs": "node scripts/gen-certs.js",
    "test:workflow": "node --test --test-reporter=spec test/workflow.test.js",
    "test:files": "node --test --test-reporter=spec test/files.test.js",
    "s3:setup": "node scripts/s3-setup.js"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/lib-storage": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@dbos-inc/dbos-sdk": "^5.2.11",
    "@google/genai": "^2.27.0",
    "@node-saml/passport-saml": "^5.1.1",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "marked": "^16.4.2",
    "openid-client": "^6.8.8",
    "passport": "^0.7.0",
    "selfsigned": "^5.5.0"
  },
  "overrides": {
    "xml-encryption": "^6.0.1"
  }
}
